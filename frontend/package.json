{
  "name": "apollo-frontend",
  "type": "module",
  "description": "Astro frontend for the ApostropheCMS + Astro Apollo template",
  "version": "1.0.0",
  "scripts": {
    "dev": "APOS_EXTERNAL_FRONT_KEY=dev astro dev",
    "start": "node ./dist/server/entry.mjs",
    "build": "astro build",
    "serve": "HOST=0.0.0.0 node ./dist/server/entry.mjs",
    "preview": "DEBUG=* astro preview",
    "astro": "astro"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@apostrophecms/apostrophe-astro": "github:apostrophecms/apostrophe#main&path:packages/apostrophe-astro",
    "@astrojs/node": "^11.1.8",
    "astro": "^7.4.0",
    "bulma": "^1.0.4",
    "postcss-viewport-to-container-toggle": "github:apostrophecms/apostrophe#main&path:packages/postcss-viewport-to-container-toggle",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "sass-embedded": "^1.106.1"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "vue-demi"
